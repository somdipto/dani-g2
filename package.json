{
  "name": "dani-g2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Dani on Even Realities G2: a work-action queue you clear from the glasses.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "evenhub-simulator \"http://127.0.0.1:5173/?demo=1\" --automation-port 9898",
    "demo": "node scripts/demo.mjs",
    "start": "node server/index.mjs",
    "pack": "npm run build && evenhub pack app.json dist -o dani.ehpk"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "engines": {
    "node": ">=22.9"
  }
}

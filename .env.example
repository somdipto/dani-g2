# Copy to .env and fill in what you need. Every value is optional; features turn on when their key is set.
# The backend (npm start) reads this file. Never commit .env.

# --- Backend ---
# Port and host. With DANI_TOKEN set it listens on all interfaces, without it only on 127.0.0.1.
PORT=8787
# HOST=0.0.0.0
# Shared secret. The glasses app sends it as "Authorization: Bearer <token>" (open the app with &token=...).
# Set this before you expose the backend to the internet.
DANI_TOKEN=
# Where the queue and audit log are stored (default: server/data.json).
# DANI_DATA=./server/data.json
# Optional webhook for items that have no handler of their own: approve POSTs {"item": ...} here.
# DANI_HANDLER_URL=

# --- Track 1: Telegram ---
# Bot token from @BotFather (/newbot). Turns the Telegram bridge on.
TELEGRAM_BOT_TOKEN=
# Chats the bot may read, comma separated: numeric ids and/or @usernames. Empty means it reads nothing.
# Get a chat id by messaging the bot, then open https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_IDS=

# --- AI reply drafts (any OpenAI-compatible endpoint) ---
# Without a key, drafts are a generic "Got it, thanks" line.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# --- Voice replies (Sarvam speech to text) ---
# Turns "Reply by voice" on. Clips are 30 seconds or less.
SARVAM_API_KEY=
# SARVAM_MODEL=saaras:v4
# SARVAM_LANGUAGE=unknown   # or a code such as en-IN, hi-IN, kn-IN
